*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# NOTE: the standard Python template's bare "lib/" and "lib64/" ignore rules
# were removed here (2026-08-28) — they were silently matching this repo's
# real analysis_system/lib/ source package (not a packaging build artifact),
# meaning every file in it had never actually been committed. If a genuine
# build-artifact lib/ directory is ever produced by a packaging tool, scope
# an ignore rule to its actual path (e.g. build/lib/) instead of a bare
# top-level name.
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

