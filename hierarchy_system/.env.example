# Copy to .env and fill in — the analysis machine's trigger_mcp_server.py address.
# Used only by trigger_mcp_client.py to manually kick off an analysis run.
ANALYSIS_SERVER_URL=http://<analysis-machine-ip>:8001/mcp

# Only needed if this vault's real data root isn't /rationalVault/data.
# Used by mcp_server.py's upload_file to know where to write reports back to.
# DATA_ROOT=/rationalVault/data

# ─────────────────────────────────────────────────────────────────────────
# Attack-checking configuration — read by mcp_server.py's get_attack_checklist
# tool and served to the analysis machine over MCP. This is the ONLY place
# attack-type checks are configured; analysis_system carries no local
# corpus, database, or embedding/RAG lookup of its own — everything it needs
# to know about which attack types to check, in what order, and against
# which files/tags on this hierarchy comes from here. See the real, fully
# populated .env in this same directory for all 38 currently-defined attack
# types (23 ported from the original corpus + 15 added for full Alert.xml /
# alertlog.xml tag coverage) — this file only shows the schema with a
# handful of worked examples.
# ─────────────────────────────────────────────────────────────────────────

# Comma-separated attack_type keys — defines BOTH which types get checked
# this run AND the order they're checked in. A type left out of this list is
# never checked at all, regardless of whether ATTACK_PRIMARY_<type> etc. are
# still set below (so you can temporarily disable a type by removing it here
# without deleting its configuration).
ATTACK_ORDER=ransomware,honeypot,log_disable

# ATTACK_PRIMARY_<type> — comma-separated list of co-equal PRIMARY evidence
# sources. Any ONE of them reading "detected" makes the whole attack type
# "detected" — this is how a multi-tag attack type (ransomware: any of 5
# tags) is expressed, as 5 primary sources rather than 1 primary + 4 checks.
#
# Each source is "<path>[#tag]":
#   - a bare path reads the WHOLE FILE as text (e.g. a log or a script's
#     plain-text output) — the fine-tuned model judges the raw content.
#   - "<path>#<tag>" reads ONE XML element's text from that path (e.g.
#     "Alert.xml#Ransom" reads just the <Ransom> tag's value).
#   - ";" inside one entry joins multiple files that get read and combined
#     into ONE reading, for cases where two files only make sense read
#     together (e.g. "var/log/secure;rationalVault/log/rationalclient.log").
# Every plain-text path (not an XML tag read) is glob-matched as a PREFIX
# (path*) to transparently handle rotating logs — this also matches the bare
# filename itself when a file doesn't rotate, so no separate "rotates" flag
# is needed.
ATTACK_PRIMARY_ransomware=Alert.xml#Ransom,Alert.xml#bin,Alert.xml#lib,Alert.xml#honeypot,Alert.xml#Process
ATTACK_PRIMARY_honeypot=Alert.xml#honeypot
ATTACK_PRIMARY_log_disable=Alert.xml#log_disable

# ATTACK_VERIFY_<type> — same shape, the VERIFICATION tier. Only reached once
# EVERY primary source reads clean. The first verification source to read
# "detected" makes the result a "discrepancy" (the primary tag said clean,
# independent evidence disagreed). Optional — omit entirely for an
# unverifiable-by-design attack type.
ATTACK_VERIFY_ransomware=athinio/system/alertlog.xml#Ransom_current_status,athinio/system/alertlog.xml#Lib_current_status,athinio/system/alertlog.xml#Bin_current_status
ATTACK_VERIFY_honeypot=athinio/system/alertlog.xml#Honeypot

# ATTACK_WRITER_<type> — human-readable provenance chain, rendered in the
# report's "Source chain". Optional, defaults to "unknown".
ATTACK_WRITER_ransomware="/athinio/bin/secOps_ransCheck (Ransom -- file-count + content diff) and /athinio/bin/Alert1.sh (bin, lib)"

# ATTACK_UI_FEATURE_<type> — the dashboard feature name referenced in a
# discrepancy's "re-run this from the dashboard" recommendation. Optional —
# falls back to a generic "the feature that manages `<file>`" phrase.
ATTACK_UI_FEATURE_ransomware="Ransomware Check (rChecker)"

# ATTACK_RELIABLE_<type> — set to "false" to mark this attack type's data
# source as known-unreliable independent of its current value: the workflow
# reports "cannot determine" instead of reading it at all. Defaults to true.
# Real example (see the populated .env): secure_vault_ransomware.
# ATTACK_RELIABLE_some_attack_type=false

# ATTACK_CAVEAT_<type> — free-text note. Rendered under "Cannot determine"
# when ATTACK_RELIABLE_<type>=false; otherwise kept as documentation only
# (not currently surfaced in the report body for a normal detected/clean
# result). Optional.
# ATTACK_CAVEAT_some_attack_type="Why this source is/isn't trustworthy..."

# LOG_FILE_PATHS — comma-separated list of paths the analysis machine's
# catch-all log-analysis pass reads for this hierarchy. Each entry is either
# an absolute server-side path (fetched as-is, same for every hierarchy,
# e.g. /var/log/secure) or a path relative to the hierarchy being analyzed
# (resolved as <vault_root>/<hierarchy>/<path>, e.g. var/log/messages).
# Optional — falls back to the three canonical security logs if unset. Same
# rationale as ATTACK_ORDER etc.: this is hierarchy-side config (which files
# exist/matter on THIS vault), not something local to the analysis machine.
LOG_FILE_PATHS=var/log/messages,var/log/secure,var/log/audit.log
