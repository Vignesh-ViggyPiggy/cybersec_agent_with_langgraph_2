# Copy to .env and fill in — the vault machine's mcp_server.py address.
# Used by lib/mcp_client.py (and everything that pulls/pushes hierarchy files
# through it: lib/anomaly_workflow.py, lib/populate_hierarchies.py).
MCP_SERVER_URL=http://<vault-machine-ip>:8002/mcp

# Only used by lib/legacy_log_aggregation.py — comma-separated list of paths
# to pull from the vault. Each entry is either an absolute server-side path
# (fetched as-is, same for every hierarchy, e.g. /var/log/secure) or a path
# relative to the hierarchy being analyzed (resolved as
# <vault_root>/<hierarchy>/<path>, e.g. var/log/messages, pulled from this
# hierarchy's own copy). ONLY these paths are pulled — nothing else is
# fetched from the vault at all for this workflow, and consolidation is
# scoped to exactly these pulled files even if other pull mechanisms have
# written other files into the same local hierarchy directory. If unset,
# falls back to the three canonical security logs (see DEFAULT_LOG_FILE_PATHS
# in lib/legacy_log_aggregation.py).
LOG_FILE_PATHS=var/log/messages,var/log/secure,var/log/audit.log

# Only used by lib/legacy_log_aggregation.py — each pulled log file is capped
# to its last LOG_TAIL_LINES lines before being sent for analysis. These logs
# grow unbounded on the client, and re-analyzing the same already-seen
# history every run wastes tokens/time for no new signal. Defaults to 300 —
# this directly bounds the classification step's prompt size (the one call
# still carrying full raw log text), confirmed slow at larger values against
# real local-Ollama inference. Raise it if a workload needs to look further
# back than that.
# LOG_TAIL_LINES=300

# Only used by lib/log_analysis_workflow.py's incident-type classification
# step — the ONE place the full raw log text still reaches the LLM. When no
# rule-based hint is present in the logs, classification runs this many
# times and takes a majority vote (self-consistency voting), to guard
# against a real observed instability (3 different answers to
# byte-identical input on a single pass). Defaults to 1 (voting off) — each
# additional pass re-sends the full log text again, which is slow at real
# log sizes; raise this only if classification correctness turns out to
# matter more than speed for your workload.
# CLASSIFICATION_VOTE_COUNT=1

# Only used by attack_status_workflow.py — comma-separated list of attack_type
# keys (the corpus entries carrying an attack_type field — see
# corpus_documents/attack_*.json, queried via lib/attack_status_data.py) to
# actually check on a given run. This is separate from the corpus itself:
# the corpus is "what attack types are known", this is "which of them this
# run should check" — e.g. a plain Linux host and an Oracle DB host would
# reasonably enable different subsets. Unset or empty means "all known
# attack types". Unknown names are skipped with a warning, not a crash.
# ENABLED_ATTACK_TYPES=ransomware,rootkit_malware,config_drift

# Only used by lib/corpus_client.py — address of corpus_server.py, the local
# vector-store service holding file/attack explanations (see
# corpus_documents/*.json for the source content). Defaults to localhost
# since this normally runs on the same machine as the workflow calling it.
# CORPUS_SERVER_URL=http://127.0.0.1:8003/mcp

# Only used by corpus_server.py itself.
# CORPUS_DB_PATH=./corpus_db
# CORPUS_EMBED_MODEL=nomic-embed-text
