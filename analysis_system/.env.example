# Copy to .env and fill in — the vault machine's mcp_server.py address.
# Used by mcp_client.py (and everything that pulls/pushes hierarchy files
# through it: anomaly_workflow.py, populate_hierarchies.py, test.py).
MCP_SERVER_URL=http://<vault-machine-ip>:8002/mcp

# Only used by legacy_log_aggregation.py — comma-separated list of paths to
# pull from the vault. Each entry is either an absolute server-side path
# (fetched as-is, same for every hierarchy, e.g. /var/log/secure) or a path
# relative to the hierarchy being analyzed (resolved as
# <vault_root>/<hierarchy>/<path>, e.g. athinio/system/rationalclient.log).
# ONLY these paths are pulled — nothing else is fetched from the vault at
# all for this workflow. If unset, falls back to a small built-in default
# list (see DEFAULT_LOG_FILE_PATHS in legacy_log_aggregation.py).
# LOG_FILE_PATHS=/var/log/secure,/var/log/osstatus.log,/var/log/audit/audit.log,athinio/system/rationalclient.log
