# Copy to .env and fill in — the vault machine's mcp_server.py address
# (hierarchy_system). Used for pulling/pushing hierarchy files AND for
# fetching the attack checklist (get_attack_checklist) — there is no
# separate corpus/database service in this package at all.
MCP_SERVER_URL=http://<vault-machine-ip>:8002/mcp

# NOTE: LOG_FILE_PATHS is NOT set here — which log files get read is
# hierarchy-side config, fetched from hierarchy_system's get_attack_checklist
# tool (LOG_FILE_PATHS in that package's .env) alongside the attack order/
# sources. Falls back to the three canonical security logs (see
# DEFAULT_LOG_FILE_PATHS in analysis.py) if that package doesn't set one.

# Each pulled log file is capped to its last LOG_TAIL_LINES lines before
# being sent for analysis. Defaults to 300 — this directly bounds the
# classification step's prompt size (the one call still carrying full raw
# log text), confirmed slow at larger values against real local-Ollama
# inference. Raise it if a workload needs to look further back than that.
# LOG_TAIL_LINES=300

# Used only by the incident-type classification step — the ONE place the
# full raw log text still reaches the LLM. When no rule-based hint is
# present in the logs, classification runs this many times and takes a
# majority vote (self-consistency voting), to guard against a real observed
# instability (different answers to byte-identical input on a single pass).
# Defaults to 1 (voting off) — each additional pass re-sends the full log
# text again, which is slow at real log sizes.
# CLASSIFICATION_VOTE_COUNT=1

# Which Ollama model name to use for both the per-source DETECTED/CLEAN
# judgment calls and the general explanation/log-classification calls.
# Defaults to "cybersecqwen" (the fine-tuned model — see model/Modelfile).
# MODEL_NAME=cybersecqwen

# Request timeout (seconds) for every Ollama call — a stuck/overloaded call
# fails with a clear exception instead of blocking forever. Defaults to 120.
# MODEL_REQUEST_TIMEOUT_SECONDS=120

# Set to 0 to force pure CPU inference (for a controlled A/B test against
# the default GPU-assisted path). Left unset, Ollama auto-decides.
# MODEL_NUM_GPU=0

# Optional CTI/STIX grounding for the log-analysis pass -- see
# threat_intel_system/. Unset (the default): log analysis behaves exactly
# as it always has, zero extra calls. Set to a reachable threat_intel_system
# mcp_server.py (same machine or a separate one -- doesn't matter, it's
# just a URL): a literal known-bad indicator found in the logs is reported
# as a deterministic threat_intel_match; otherwise retrieved CTI narratives
# are offered to the classifier as background context only, never as proof
# by themselves -- a run with nothing configured or nothing reachable here
# falls back to today's exact behavior automatically, no error either way.
# THREAT_INTEL_SERVER_URL=http://localhost:8003/mcp
# THREAT_INTEL_TIMEOUT_SECONDS=5

# NOTE: there is no ENABLED_ATTACK_TYPES here, and no CORPUS_* variable of
# any kind — which attack types get checked, in what order, and against
# which files/tags is configured entirely on the vault side, in
# hierarchy_system/.env (ATTACK_ORDER, ATTACK_PRIMARY_<type>, etc.). This
# package still has no local corpus or database of its own -- the optional
# CTI store above lives in the separate threat_intel_system package.
