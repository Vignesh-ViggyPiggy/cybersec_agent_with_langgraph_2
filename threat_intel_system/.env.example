# Copy to .env and adjust. This service can run on the SAME machine as
# analysis_system (point analysis_system's THREAT_INTEL_SERVER_URL at
# localhost) or on a completely separate machine (point it at that
# machine's address instead) -- nothing here or in the calling code
# changes either way, only the URL analysis_system is configured with.

# Where the SQLite file lives. Relative paths resolve against this
# package's own directory.
DB_PATH=threat_intel.db

# Ollama embedding model used for the narrative-similarity tier. Must
# already be pulled on whichever machine runs mcp_server.py:
#   ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# Port mcp_server.py binds on (0.0.0.0). hierarchy_system uses 8002,
# analysis_system's trigger_mcp_server.py uses 8001 -- this defaults to
# 8003 to avoid colliding with either on a co-located deployment.
PORT=8003
